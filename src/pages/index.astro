---
import type { MediaItem } from '@/lib/types/MediaItem';
import Layout from '@/layouts/Layout.astro';
import Alert from '@/components/shared/Alert.astro';
import MediaSection from '@/components/MediaSection.astro';
import Greetings from '@/components/Greetings';
import { albumRepository, playlistRepository } from '@/lib/repositories';

import { AppError } from '@/lib/utils/errorHandling';
import type { AlbumResult, PlaylistResult } from '@/lib/types/SearchResultItem';

let albums: MediaItem[] = [];
let playlists: MediaItem[] = [];
let fetchAlbumsError: string | null = null;
let fetchPlaylistsError: string | null = null;

// 1. Fetch albums
try {
  const albumResults: AlbumResult[] = await albumRepository.getAll(
    Astro.url.origin.toString()
  );
  albums = albumResults.map(
    (a: AlbumResult): MediaItem => ({
      id: a.id,
      title: a.title,
      href: a.href,
      coverArtUrl: a.coverArtUrl,
      type: 'album' as const,
      artists: a.artists ? a.artists : [],
      color: a.color,
    })
  );
} catch (error: any) {
  if (error instanceof AppError) {
    console.error(
      `Error fetching albums (Code: ${error.code}, Status: ${error.statusCode}): ${error.message}`,
      error.details
    );
    fetchAlbumsError = `Could not load albums: ${error.message}`;
  } else {
    console.error(
      'Error fetching albums in index.astro:',
      error.message || error
    );
    fetchAlbumsError =
      'Could not load albums at this time. An unexpected error occurred.';
  }
}

// 2. Fetch playlists
try {
  const playlistResults: PlaylistResult[] =
    await playlistRepository.getGlobalPlaylists(Astro.url.origin.toString());
  playlists = playlistResults.map(
    (p: PlaylistResult): MediaItem => ({
      id: p.id,
      title: p.title,
      href: p.href,
      coverArtUrl: p.coverArtUrl,
      type: 'playlist' as const,
      artists: p.artists ? p.artists : [],
      color: p.color,
    })
  );
} catch (error: any) {
  const playlistErrorMessage = 'Could not load playlists at this time.';
  let newPlaylistErrorMessage: string;
  if (error instanceof AppError) {
    console.error(
      `Error fetching playlists (Code: ${error.code}, Status: ${error.statusCode}): ${error.message}`,
      error.details
    );
    newPlaylistErrorMessage = `Could not load playlists: ${error.message}`;
  } else {
    console.error(
      'Error fetching playlists in index.astro:',
      error.message || error
    );
    newPlaylistErrorMessage = `${playlistErrorMessage} An unexpected error occurred.`;
  }
  fetchPlaylistsError = newPlaylistErrorMessage;
}
---

<Layout title='Musicfy - Music for Everyone'>
  <div class='relative transition-all duration-1000 bg-accent'>
    <div class='relative z-10 px-4 pt-10 md:px-6'>
      <Greetings client:load />

      <!-- Errors -->
      {
        fetchAlbumsError && (
          <Alert type='error' title='Albums Error' message={fetchAlbumsError} />
        )
      }
      {
        fetchPlaylistsError && (
          <Alert
            type='error'
            title='Playlists Error'
            message={fetchPlaylistsError}
          />
        )
      }

      <!-- Albumbs section -->
      <MediaSection
        sectionTitle='Discover Albums'
        items={albums}
        emptyStateMessage='No albums to display at the moment. Check back soon!'
        hasError={!!fetchAlbumsError}
        titleClass='text-[#695d3a]'
      />

      <!-- Playlists section -->
      <MediaSection
        sectionTitle='Featured Playlists'
        items={playlists}
        emptyStateMessage='No playlists to display at the moment.'
        hasError={!!fetchPlaylistsError}
      />

      <!-- Background gradient -->
      <div
        class='absolute inset-0 bg-gradient-to-t from-primary via-primary/95 to-transparent -z-[1]'
      >
      </div>
    </div>
  </div>
</Layout>
