---
import { playlists } from '@/lib/data';
import Layout from '@/layouts/Layout.astro';
import PlaylistItemCard from '@/components/PlaylistItemCard.astro';
import Greetings from '@/components/Greetings';
---

<Layout title='Musicfy'>
  <div class='relative transition-all duration-1000 bg-accent'>
    <div class='relative z-10 px-4 pt-10 md:px-6'>
      <Greetings />

      <div
        class='grid grid-cols-[repeat(auto-fit,minmax(150px,1fr))] mt-6 gap-4 md:gap-6'
      >
        {playlists.map((playlist) => <PlaylistItemCard playlist={playlist} />)}
      </div>

      <div
        class='absolute inset-0 bg-gradient-to-t from-primary via-primary/80 -z-[1]'
      >
      </div>
    </div>
  </div>
</Layout>
