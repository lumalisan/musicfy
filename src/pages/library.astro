---
import Layout from '@/layouts/Layout.astro';
import { CreatePlaylistModal } from '@/components/library/CreatePlaylistModal';
import type { MediaItem } from '@/lib/types/MediaItem';
import MediaSection from '@/components/MediaSection.astro';
import Alert from '@/components/shared/Alert.astro';
import { playlistRepository } from '@/lib/repositories';
import { AppError } from '@/lib/utils/errorHandling';
import type { PlaylistResult } from '@/lib/types/SearchResultItem';

const { userId: clerkUserId, sessionId } = Astro.locals.auth();

let playlists: MediaItem[] = [];
let fetchError: string | null = null;

if (!clerkUserId || !sessionId) {
  return Astro.redirect('/');
}

try {
  const playlistResults: PlaylistResult[] =
    await playlistRepository.getUserPlaylists(
      Astro.url.origin.toString(),
      Astro.request.headers
    );

  playlists = playlistResults.map(
    (p: PlaylistResult): MediaItem => ({
      id: p.id,
      title: p.title,
      href: p.href,
      coverArtUrl: p.coverArtUrl,
      type: 'playlist' as const,
      artists: p.artists ? p.artists : [],
      color: p.color,
    })
  );
} catch (error: any) {
  if (error instanceof AppError) {
    console.error(
      `Error fetching user playlists (Code: ${error.code}, Status: ${error.statusCode}): ${error.message}`,
      error.details
    );
    fetchError = `Could not load your playlists: ${error.message}`;
  } else {
    console.error(
      'Error fetching user playlists in library.astro:',
      error.message || error
    );
    fetchError = 'Could not load your playlists. An unexpected error occurred.';
  }
}
---

<Layout title='Musicfy - Your Library'>
  <div class='p-4 md:p-6 mt-12 md:mt-0'>
    <div class='flex justify-between items-start sm:items-center mb-8 gap-4'>
      <h1 class='text-3xl font-bold'>Your Library</h1>

      <CreatePlaylistModal client:load />
    </div>

    {
      fetchError && (
        <Alert
          type='error'
          title='Oops!'
          message={fetchError}
          redirectText='Go home'
          redirectUrl='/'
        />
      )
    }

    <MediaSection
      items={playlists}
      hasError={!!fetchError}
      emptyStateMessage='Your library is empty. Start by creating a new playlist!'
    />
  </div>
</Layout>
