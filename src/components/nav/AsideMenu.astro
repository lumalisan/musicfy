---
import type { MediaItem } from '@/lib/types/MediaItem';
import { FontAwesomeIcon } from '@fortawesome/react-fontawesome';
import {
  faBook,
  faHome,
  faSearch,
  faUser,
} from '@fortawesome/free-solid-svg-icons';
import {
  SignedIn,
  SignedOut,
  SignInButton,
  UserButton,
} from '@clerk/astro/components';

import { API_BASE_URL } from '@/lib/constants';

import { LibraryLoginPopover } from './LibraryLoginPopover';
import SideMenuItem from './SideMenuItem.astro';
import SideMenuCard from './SideMenuCard.astro';

let playlists: MediaItem[] = [];

// Fetch playlists
try {
  const playlistsResponse = await fetch(
    `${Astro.url.origin}${API_BASE_URL}/playlists.json`
  );
  if (playlistsResponse.ok) {
    playlists = await playlistsResponse.json();
  } else {
    const errorData = await playlistsResponse
      .json()
      .catch(() => ({ error: 'Failed to parse playlists error' }));
    console.error(
      'Failed to fetch playlists:',
      playlistsResponse.status,
      errorData.error
    );
  }
} catch (error: any) {
  console.error('Error fetching playlists in index.astro:', error);
}
---

<nav class='flex flex-col flex-1 gap-2' aria-label='Main navigation'>
  <div class='bg-primary rounded-lg p-2'>
    <ul>
      <SideMenuItem href='/'>
        <FontAwesomeIcon icon={faHome} fixedWidth className='text-xl' />
        Home
      </SideMenuItem>
      <SideMenuItem href='/search'>
        <FontAwesomeIcon icon={faSearch} fixedWidth className='text-xl' />
        Search
      </SideMenuItem>
    </ul>
  </div>

  <div class='bg-primary rounded-lg p-2 flex-1 flex flex-col min-h-0'>
    <ul class='flex-1 overflow-y-auto'>
      <SignedOut>
        <LibraryLoginPopover
          triggerClassName='flex gap-4 w-full text-accent/70 cursor-pointer hover:text-accent items-center py-3 px-5 font-medium transition duration-300'
          side='right'
          sideOffset={-20}
          client:load
        />
      </SignedOut>

      <SignedIn>
        <SideMenuItem href='/library'>
          <FontAwesomeIcon icon={faBook} fixedWidth className='text-xl' />
          Your Library
        </SideMenuItem>
      </SignedIn>

      {
        playlists.length > 0
          ? playlists.map((item) => (
              <li>
                <SideMenuCard item={item} />
              </li>
            ))
          : null
      }
    </ul>

    <div class='border-t border-accent/80 pt-2'>
      <SignedIn>
        <span class='flex items-start justify-start'>
          <UserButton showName appearance={{
            elements: {
              userButtonBox: 'flex justify-between gap-4 w-full text-accent/70 cursor-pointer hover:text-accent items-center py-2 px-5 font-medium transition duration-300',
            },
          }} />
        </span>
      </SignedIn>
      <SignedOut>
        <SignInButton mode='modal' class='w-full'>
          <ul>
            <SideMenuItem>
              <FontAwesomeIcon icon={faUser} className='text-xl' />
              Sign In
            </SideMenuItem>
          </ul>
        </SignInButton>
      </SignedOut>
    </div>
  </div>
</nav>
