---
import type { MediaItem } from '@/lib/types/MediaItem';
import { FontAwesomeIcon } from '@fortawesome/react-fontawesome';
import {
  faBook,
  faHome,
  faSearch,
  faUser,
} from '@fortawesome/free-solid-svg-icons';
import {
  SignedIn,
  SignedOut,
  SignInButton,
  UserButton,
} from '@clerk/astro/components';

import { playlistRepository } from '@/lib/repositories';
import { AppError } from '@/lib/utils/errorHandling';
import type { PlaylistResult } from '@/lib/types/SearchResultItem';

import { LibraryLoginPopover } from './LibraryLoginPopover';
import SideMenuItem from './SideMenuItem.astro';
import SideMenuCard from './SideMenuCard.astro';

let playlists: MediaItem[] = [];

// Fetch playlists
try {
  const results: PlaylistResult[] = await playlistRepository.getGlobalPlaylists(Astro.url.origin.toString());
  playlists = results.map(
    (p: PlaylistResult): MediaItem => ({
      id: p.id,
      title: p.title,
      href: p.href,
      coverArtUrl: p.coverArtUrl,
      type: 'playlist' as const,
      artists: p.artists,
      color: p.color,
    })
  );
} catch (error: any) {
  if (error instanceof AppError) {
    console.error(`Error fetching playlists in AsideMenu (Code: ${error.code}, Status: ${error.statusCode}): ${error.message}`, error.details);
  } else {
    console.error('Error fetching playlists in AsideMenu.astro:', error.message || error);
  }
  playlists = [];
}
---

<nav class='flex flex-col flex-1 gap-2' aria-label='Main navigation'>
  <div class='bg-primary rounded-lg p-2'>
    <ul>
      <SideMenuItem href='/'>
        <FontAwesomeIcon icon={faHome} fixedWidth className='text-xl' />
        Home
      </SideMenuItem>
      <SideMenuItem href='/search'>
        <FontAwesomeIcon icon={faSearch} fixedWidth className='text-xl' />
        Search
      </SideMenuItem>
    </ul>
  </div>

  <div class='bg-primary rounded-lg p-2 flex-1 flex flex-col min-h-0'>
    <ul class='flex-1 overflow-y-auto'>
      <SignedOut>
        <LibraryLoginPopover
          triggerClassName='flex gap-4 w-full text-accent/70 cursor-pointer hover:text-accent items-center py-3 px-5 font-medium transition duration-300'
          side='right'
          sideOffset={-20}
          client:load
        />
      </SignedOut>

      <SignedIn>
        <SideMenuItem href='/library'>
          <FontAwesomeIcon icon={faBook} fixedWidth className='text-xl' />
          Your Library
        </SideMenuItem>
      </SignedIn>

      {
        playlists.length > 0
          ? playlists.map((item) => (
              <li>
                <SideMenuCard item={item} />
              </li>
            ))
          : null
      }
    </ul>

    <div class='border-t border-accent/80 pt-2'>
      <SignedIn>
        <span class='flex items-start justify-start'>
          <UserButton
            showName
            appearance={{
              elements: {
                userButtonBox:
                  'flex justify-between gap-4 w-full text-accent/70 cursor-pointer hover:text-accent items-center py-2 px-5 font-medium transition duration-300',
              },
            }}
          />
        </span>
      </SignedIn>
      <SignedOut>
        <SignInButton mode='modal' class='w-full'>
          <ul>
            <SideMenuItem>
              <FontAwesomeIcon icon={faUser} className='text-xl' />
              Sign In
            </SideMenuItem>
          </ul>
        </SignInButton>
      </SignedOut>
    </div>
  </div>
</nav>
