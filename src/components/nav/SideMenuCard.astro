---
import type { MediaItem } from '@/lib/types/MediaItem';

interface Props {
  item: MediaItem;
}

const { item } = Astro.props;
const { id, artists, coverArtUrl, title, type } = item;

const artistsString = artists.join(', ');
const href = type === 'playlist' ? `/playlist/${id}` : `/album/${id}`;
---

<a
  href={href}
  class='playlist-item flex relative p-2 overflow-hidden items-center gap-5 rounded-md hover:bg-accent/10 transition duration-300 group'
  title={`${title} by ${artistsString}`}
>
  <picture class='h-12 w-12 flex-none'>
    {
      coverArtUrl ? (
        <img
          src={coverArtUrl}
          alt={`Cover for ${title}`}
          class='object-cover w-full h-full rounded-md'
          loading='lazy'
        />
      ) : null
    }
  </picture>
  <div class='flex flex-col flex-auto truncate'>
    <h4
      class='text-accent font-medium text-base group-hover:text-white transition-colors'
    >
      {title}
    </h4>
    <span class='text-accent/70 text-sm'>
      {artistsString || (type === 'playlist' ? 'Playlist' : 'Album')}
    </span>
  </div>
</a>
